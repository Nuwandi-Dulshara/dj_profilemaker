# Django configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL Database configuration
DB_NAME=profile_studio_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Generate a Fernet key. Never use the Django SECRET_KEY as this encryption key.
CV_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/cv/oauth/google/callback/
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/cv/oauth/microsoft/callback/

# Optional. Set when installing Chromium in a custom directory.
# PLAYWRIGHT_BROWSERS_PATH=D:/path/to/project/backend/venv/playwright-browsers
CV_PDF_TIMEOUT_SECONDS=45
CV_PDF_CONCURRENCY=2

# CV document imports (10 MB), OCR and real AI suggestions
CV_UPLOAD_MAX_BYTES=10485760
CV_EXTRACT_MEMORY_MB=512
CV_TESSERACT_COMMAND=tesseract
CV_OCR_LANGUAGE=eng
# HTTPS chat-completions-compatible endpoint; credentials stay on the backend.
CV_AI_URL=
CV_AI_KEY=
CV_AI_MODEL=
# Optional JSON overrides: compatibility, content, jobMatch, keywords, formatting, contact
CV_SCORE_WEIGHTS={}
